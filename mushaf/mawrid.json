اقِ الهمزتَينْ","إنْ جاءتا بالضَّمِّ أوْ مكسورتَينْ"],["وكُلُّ ما وجدتَهُ منْ نَبْرِ","منْ غيرِ صورةٍ فضَعْ في السَّطْرِ"],["وما بشكلٍ فوقَهُ ما يُفتَحُ","معْ ساكنٍ، وما بكسرٍ يُوضَحُ"],["منْ تحتُ، والمضمومُ فوقَهُ أُلِفْ","لكنَّهُ بوَسْطٍ منَ الألِفْ"],["ثمّ امتحِنْ موضعَهُ بالعينِ","حيثُ استقرَّتْ ضَعْهُ دونَ مَيْنِ"],["كـ: عامَنوا في: ءامَنوا، والسُّوعُ","في: السُّوءِ، والمُسيءُ كـ: المُسيعُ"],["وخُصَّتِ العينُ لما بينَهما","منْ شدّةٍ وقُرْبِ مخرجَيهما"],["لأجلِ ذا خَطَّتْ عنِ الثِّقاتِ","عَيْنًا منَ الكُتّابِ والنُّحاةِ"],["وكُلُّ ما منْ همزتَينِ وردا","في كلمةٍ بصورةٍ قدْ أُفرِدا"],["فقيلَ: صورةٌ للاُولى منهما","وقيلَ: بلْ هيَ إلى ثانيهما"],["وذا الأخيرُ اختيرَ في المتّفقَينْ","وأوَّلُ الوجهَينِ في المختلفَينْ"],["ففي اتّفاقٍ تُجعَلُ المُبيَّنهْ","منْ قبلِها وفوقَها المُليَّنهْ"],["وفي اختلافٍ فوقَها الصّفراءُ","ونقطةٌ أمامَها حمراءُ"],["وإنْ تشأْ فاجعلْ هنا ما سُهِّلا","واوًا بنحوِ قولِهِ: أُؤنزِلَ"],["والياءَ في الباقي منَ المختلِفِ","حُمْرًا، وءالِهَتُنا في الزُّخرُفِ"],["وقولُهُ: ءامَنتمُ مُستفهِما","الحكمُ فيهِنَّ كما تقدَّما"],["لكنَّ بعدَ ألفٍ ألحقتَا","حمراءَ مثلَ هذهِ إنْ أنتَا"],["جعلتَ هذهِ هيَ المُليَّنهْ","وإنْ جعلتَها هيَ المُسكَّنهْ"],["فالألفَ الحمراءَ قبلُ ألحِقَنْ","وانقُطْ عليها أوْ بنَقْطٍ عوِّضَنْ"],["وإنْ يكنْ مُسكَّنٌ منْ قبلُ","صحَّ فحُكمُها لورشٍ: نقلُ"],["تُسقِطُها منْ بعدِ نقلِ شكلِها","وجَرَّةً تُجعَلُ في محلِّها"],["وقبلَ ذي الكحلاءِ أيضًا تُجعَلُ","حُمْرًا على مذهبِ مَنْ قدْ يَفْصِلُ"],["لدى اتّفاقٍ واختلافٍ بعدَهْ","وإنْ تشأْ عوِّضْهُما بـ: مَدَّهْ"],["وهمزُ (ءالآنَ) إذا ما أُبدِلا","وبابِهِ مَطٌّ عليهِ جُعِلا"],["ولكَ في (ءأنتَ) أنْ تعتبرهْ","وبابِهِ ولا تقسْ: شاءَ أنشرهْ"],["القولُ في الصِّلةِ عندَ الوصْلِ","وحُكمِ الابتداءِ ثمّ النّقْلِ"],["فصِلةٌ للحركاتِ تتْبعُ","ففوقَهُ منْ بعدِ فتحٍ تُوضَعُ"],["وتحتَهُ إنْ كسرةٌ، ووسْطَهْ","إنْ ضمّةٌ كذا أتتْ مُرتبطَهْ"],["وإنْ تُنوِّنْ تحتَهُ جعلْتا","ووسَطًا إنْ ثالثًا ألزمْتا"],["ضمًّا، ووضعُ ضبطِ الابتداءِ","نقْطٌ ـ كوضعِ الشّكلِ ـ بالخضراءِ"],["أمامَهُ إذا بضمٍّ ابتدأتْ","وفوقُ إنْ فتحٌ، وتحتُ إنْ كُسِرتْ"],["وحكمُها لورْشِهمْ في النّقْلِ","كحُكمِها في ألِفاتِ الوصْلِ"],["ففوقَهُ أوْ تحتَهُ أوْ وسَطا","في موضعِ الهمزِ الّذي قدْ سقطا"],["فإنْ أتى منْ بعدِ همزٍ ألِفُ","فقبْلَهُ محلَّ همزٍ تألَفُ"],["القولُ في النّقصِ منَ الهجاءِ","إنْ شئتَ أنْ تُلحِقَ بالحمراءِ"],["أوّلَ ما الثّاني بهِ قدْ دخلا","علامةً للجمعِ أوْ أنْ أُصِّلا"],["نحوُ: النّبيّينَ، تراءَا، ثُمّ ما","أُولاهُما ضُمّتْ ففي الثّاني كما"],["هذا كـ: يلْوُونَ، وإنْ شدّدْتَا","كنحوِ: الأُمّيّينَ، والتزمْتا"],["أنْ تُلحِقَ الأُخرى إذا ما حُذِفتْ","في ما بهِ أُولاهُما قدْ سكنتْ"],["وإنْ حذفتَ ما عليهِ بُنِيا","اللّفظُ نحوُ قولِهِ: ما وُۥرِيَ"],["ففيهِ تخييرٌ لدى الإلحاقِ","وإنْ تكُ الأُولى فباتّفاقِ"],["وعكسُ هذا جاءَ في: جاءَانا","وحذفُ آخِرٍ بهِ استبانا"],["وألحِقَنْ ألفًا توسّطا","ممّا منَ الخطِّ اختصارًا سقطا"],["وما بواوٍ أوْ بياءٍ كُتِبا","عنْ واوٍ اوْ عنْ حرفِ ياءٍ قُلِبا"],["وإنْ تطرّفتْ كذا تكونُ","ما لمْ يقعْ منْ بعدِها سُكونُ"],["ومعَ لامٍ أُلحِقتْ يُمْناهُ","لأسفلٍ منْ مُنتهى أعلاهُ"],["ما لمْ تكنْ بواوٍ اوْ ياءٍ أتتْ","وقيلَ: يُمْناهُ بكلٍّ أُلحِقتْ"],["لكنْ منِ اسمِ اللهِ رسمًا حُطّا","واللّاتَ بالإلحاقِ فرقًا خطّا"],["وألحِقَنْ ألِفَيِ: ادّارأْتُمْ","والياءَ منْ: إۦلٰفِهِمْ، وترسُمُ"],["ثاني (نُۨجِي) يوسُفٍ والأنبيا","حمْرًا، وأوّلًا بباب: حَيِيَ"],["واختيرَ تركُ لحْقِ: تُـٔوِي، رُءْيا","والحِقْ: أوْلياءَ واوًا أوْ يا"],["إنْ شئتَ في اتّصالِهِ بمُضمَرِ","وهمزُهُ في الخطِّ لمْ يُصوَّرِ"],["قياسُهُ: جزَٰٓؤُهُۥ في يوسُفا","لكنّ في نصوصِهمْ ما أُلِفا"],["ونونُ (تأمَنّا) إذا ألحقْتَهْ","فانقُطْ أمامًا أوْ بهِ عوّضْتَهْ"],["القولُ في ما زِيدَ في الهجاءِ","مِنْ ألفٍ أوْ واوٍ اوْ منْ ياءِ"],["فكُلُّ ما الألفُ فيهِ أُدخِلا","كقولِهِ: لأاذبحَنَّ، لإلى"],["وشبهِهِ ممّا بقي: فالمُتّصِلْ","باللّامِ صورةٌ، وقيلَ: المُنفصِلْ"],["وزيدَ ما في: مائةٍ وجايءَ","وتايْئَسوا وشبهِهِ مَجيئا"],["وبعدَ واوِ الفرْدِ، ثمّ تفتؤا","وبابِهِ، وفي الرِّبوا وفي امرؤا"],["وزيدَ أيضًا ياءُ: مِنْ ءانائي","وبابِهِ، والواوُ في: أولاءِ"],["وآخرُ الياءَيْنِ منْ: بأيْيَدٍ","للفرقِ بينَهُ وبينَ الأيدي"],["فدارةٌ تلزمُ ذا المزيدا","منْ فوقِهِ علامةً أنْ زيدا"],["وشدِّدِ الثّانيَ منْ: بأيِّيكمْ","وعَرِّ أوَّلًا لما قدْ يُدّغَمْ"],["القولُ فيما جاءَ في: اللّامِ ألِفْ","الحكمُ في الهمزةِ منهُ مُختلِفْ"],["فقيلَ: ثانيهِ، وقيلَ: الأوَّلُ","وهمْزُ أوَّلٍ هو المُعوَّلُ"],["ومدُّهُ إنْ كانَ ما يُمدُّ","لأجلِ همزٍ كائنٍ منْ بعدُ"],["إذْ أصلُهُ حرفانِ نحوُ: يا وما","فظَفِرا خطًّا كما قدْ رُسِما"],["وإنْ يكنْ ذا الهمزُ في نفسِ الألفْ","فحُكمُهُ كما مضى لا يختلِفْ"],["وبعدَ لامِ ألفٍ إنْ رُسِما","مُؤخَّرًا، وقبلُ إنْ تقدَّما"],["وكُلُّ ما ذكرتُ منْ تنوينِ","أوْ حركاتٍ، ومنَ السُّكونِ"],["والقلبِ للباءِ، وما للهاءِ","منْ صِلةٍ منْ واوٍ اوْ منْ ياءِ"],["ونحوِ: يدعُ الدّاعِ، والتّشديدِ","ومَطّةٍ، ودارةِ المزيدِ"],["ونقطِ تأمَنّا، وما يُشَمُّ","معَ الّذي اختلستَهُ، فالحُكمُ"],["أنْ تجعلَ الجميعَ بالحمراءِ","هذا تمامُ الضّبطِ والهجاءِ"],["محمَّدٌ جاءَ بهِ منظوما","نجلُ محمَّدِ بنِ إبراهيمْ"],["الأُمويُّ نسَبًا، وأنشأهْ","عامَ ثلاثٍ معَها سبعُمائهْ"],["عِدَّتُهُ: أربعةٌ وعشرهْ","جاءتْ لخمسِمائةٍ مُقتفِرهْ"],["فإنْ أكُنْ بدَّلتُ شيئًا غَلَطا","منّي أوِ اغفلتُهُ فسقطا"],["فادْرِكْهُ مُوقِنًا ولتَسْمَحِ","فيما بدا منْ خللٍ ولتَصْفَحِ"],["ما كُلُّ مَنْ قدْ أمَّ قَصْدًا يرشُدُ","أوْ كُلُّ مَنْ طلبَ شيئًا يجدُ"],["لكنَّ رجائي فيهِ أنْ لا غيرا","فما صفا خُذْ، واعفُ عمّا كَدُرا"],["ولستُ مُدَّعيًا الإحصاءَ","ولوْ قصدتُ فيهِ الاستقصاءَ"],["إذْ ليسَ ينبغي اتّصافٌ بالكمالْ","إلّا لربّي الكبيرِ المُتعالْ"],["وفوقَ كُلِّ منْ ذوي العلمِ عليمْ","ومُنتهى العلمِ إلى اللهِ العظيمْ"],["كيفَ وما ذكري سوى ما اشتهرا","عنْ جُلِّهِمْ وما إليهِ ابتدرا"],["إلّا يسيرةً سوى المُشتهِرهْ","أوردتُها زيادةً وتذكرهْ"],["فالحمدُ للهِ على إكمالِهِ","وما بهِ قدْ مَنَّ منْ إفضالِهِ"],["حمدًا كثيرًا طيِّبًا مُجدَّدا","مُتّصلًا دونَ انقطاعٍ أبدا"],["وانفعْ بهِ اللّهمَّ مَنْ قدْ أمّا","إليهِ درسًا أوْ حواهُ فهما"],["واجعلْهُ ربِّ خالصًا لذاتِكْ","وقائدًا بنا إلى جنّاتِكْ"],["عساهُ دائمًا بهِ يُنتفَعُ","ليومِ لا مالٌ ولا ابنٌ ينفعُ"],["ويا إلهي عظُمتْ ذنوبي","وليسَ لي غيرُكَ منْ طبيبِ"],["فامنُنْ عليَّ سيِّدي بتوبهْ","عسى الّذي جنيتُهُ منْ حَوْبهْ"],["يذهبُ عنّي، وإليكَ رغبتي","في الصَّفْحِ عنْ مُقترَفي وزَلَّتي"],["وحَجّةٍ لبيتِكَ الحرامِ","ووقفةٍ بذلكَ المقامِ"],["واغفرْ لوالدَيَّ ما قدْ فعلا","منْ سيِّئٍ رُحماكَ يا ربَّ العُلا"],["وارحمْ بفضلٍ منكَ مَنْ علَّمنا","كتابَكَ العزيزَ أوْ أقرأنا"],["بجاهِ سيِّدِ الورى المُؤمَّلِ","محمَّدٍ ذي الشَّرَفِ المُؤثَّلِ"],["صلّى الإلهُ ربُّنا عليهِ","ما حنَّ شوقًا دَنِفٌ إليهِ"]],"sm":[{"s":1,"e":43,"t":"مقدمة الناظم"},{"s":44,"e":78,"t":"ما اتُّفق أو اختُلف على حذف ألفه ونظائره من فاتحة الكتاب"},{"s":79,"e":159,"t":"ما اختُلف أو اتُّفق على حذف ألفه ونظائره من سورة البقرة"},{"s":160,"e":188,"t":"ما اتُّفق أو اختُلف على حذف ألفه ونظائره من آل عمران إلى الأعراف"},{"s":189,"e":219,"t":"ما اتُّفق أو اختُلف على حذف ألفه ونظائره من الأعراف إلى مريم"},{"s":220,"e":240,"t":"ما اطّرد حذف ألفه ونظائره أو لم يطّرد من مريم إلى صاد"},{"s":241,"e":254,"t":"الألفات المحذوفة أو الثابتة من سورة صاد إلى آخر القرآن"},{"s":255,"e":282,"t":"الياءات المحذوفة اكتفاءً بكسر ما قبلها"},{"s":283,"e":288,"t":"الواوات المحذوفة اكتفاءً بضمّ ما قبلها"},{"s":289,"e":290,"t":"باب حذف إحدى اللامين"},{"s":291,"e":337,"t":"أحكام رسم الهمز"},{"s":338,"e":356,"t":"الحروف الزائدة رسمًا"},{"s":357,"e":385,"t":"رسم الألف ياءً"},{"s":386,"e":390,"t":"رسم الواو ياءً"},{"s":391,"e":396,"t":"رسم الألف واوًا"},{"s":397,"e":421,"t":"الكلمات التي كُتبت مفصولة على الأصل"},{"s":422,"e":433,"t":"الكلمات التي كُتبت موصولة على اللفظ"},{"s":434,"e":448,"t":"هاءات التأنيث المرسومة بالتاء"},{"s":449,"e":454,"t":"خاتمة نظم الرسم"},{"s":455,"e":458,"t":"مقدمة الذيل في الضبط"},{"s":459,"e":481,"t":"أحكام وضع الحركة وما ينوب عنها"},{"s":482,"e":496,"t":"أحكام وضع السكون والشدّة وعلامة المدّ"},{"s":497,"e":502,"t":"ضبط المدغم والمظهر"},{"s":503,"e":534,"t":"ضبط الهمز"},{"s":535,"e":543,"t":"صلة همزة الوصل والابتداء بها وحكم النقل"},{"s":544,"e":563,"t":"إلحاق المحذوف من الهجاء"},{"s":564,"e":572,"t":"ضبط ما زيد في الهجاء"},{"s":573,"e":578,"t":"حكم اللام ألف"},{"s":579,"e":608,"t":"ألوان الضبط وخاتمة المنظومة"}],"i":[["بحمدِ ربِّهِ ابتدا ابنُ عاشرِ","مُصلّيًا على النّبيِّ الحاشرِ"],["هاكَ زوائدَ لـ(موردٍ) تَفي","بالسّبعِ مَعْهُ منْ خِلافِ المصحَفِ"],["المدنيْ والمكِّ والإمامِ","والكوفِ والبصْرِ معًا والشّامي"],["فارسمْ لكُلِّ قارئٍ منها بما","وافقَهُ إنْ كانَ ممّا لَزِما"],["أوْ بمُخالفٍ خلافًا اغتُفِرْ","وكُنْ في الاجماعِ منَ الخُلفِ حَذِرْ"],["وما خلا عنْ خُلفِها فمُفرَدُ","كـنافعٍ، لكنْ يُراعى (الموردُ)"],["ووفِّقَنْ بالرّسمِ مُمكِنَ الوِفاقْ","كـ: ليسُـٔوا ورءوفٌ، لا شِقاقْ"],["منْ سورةِ الحمدِ للاعرافِ اعرِفا","فياءَ: إبرٰهمَ في البِكرِ احذِفا"],["لغيرِ حِرميٍّ، وقالوا اتّخذَ","يحذفُ شامٍ واوَهُ، أوصى خُذا"],["للمدنيَّينِ وشامٍ بالألفْ","يُقٰتِلونَ تلوَ حقٍّ مُختلَفْ"],["والمكِّ والعراقِ واوًا: سارعوا","بالزُّبُرِ: الشّامي بباءٍ شائعُ"],["كذا: الكتٰبِ بخلافٍ عنهُمُ","والشّامُ ينصِبُ: قليلًا منهُمُ"],["واوَ: يقولُ للعراقيِّ فزِدْ","والمدنيّانِ وشامٍ: يرتدِدْ"],["لَلدّارُ: للشّامِ بلامٍ، وهُنا","قدْ حذفَ الكوفيُّ تا: أنجيتَنا"],["وشُركاؤُهمْ ليُردوهمْ: بيا","للشّامِ في محلِّ همزٍ أُبدِيا"],["في: سٰحرٍ العقودِ معْ هودَ اختُلِفْ","وأوَّلٍ بيونسٍ كذا أُلِفْ"],["منْ سورةِ الأعرافِ حتّى مريما","تذّكّرونَ: الشّامُ ياءً قدَّما"],["واوُ: وما كنّا لهُ أُبينا","بعكسِ: قالَ، بعدَ مُفسِدينا"],["بكُلِّ سحَّـٰرٍ: معًا هلْ بالألفْ","وهلْ يلي الحا أوْ قُبَيْلَها: اختُلِفْ"],["بالألفِ الشّامُ: إذْ انجىٰكمْ، ومِنْ","معْ تحتِها: آخرَ توبةٍ يَعِنّْ"],["للمكِّ، والّذينَ: بعدُ المدني","والشّامُ لا واوَ بها، فاستبِنِ"],["كلمتُ: الثّاني بيونسٍ هُما","بالتّا، وفي العراقِ بالها ارتسَما"],["وفي: يُسيِّرُكُمْ: يَنشُرُكُمْ","للشّامِ، قُلْ سبحانَ: قالَ قدْ رُسِمْ"],["لهُ وللمكّيِّ، ثمّ منهُما","مُنقَلَبًا: منها العراقي رسما"],["معًا خرٰجًا: بخلافٍ قدْ أتى","وفَخَراجُ: للجميعِ أُثبِتا"],["مكَّنَني: للمكِّ نونًا ثانيا","والكُلُّ: ءاتوني معًا بغيرِ يا"],["منْ مريمٍ لصادَ: قُلْ ذا الأوَّلُ","في الأنبيا للكوفِ: قالَ يُجعَلُ"],["في قالَ كمْ معْ قالَ إنْ عكسٌ جرى","لا واوَ للمكّيِّ في: ألمْ يَرَ"],["في المؤمنينَ آخرَيْ: للهِ زِدْ","للبصْرِ والإمامِ همزًا اعتَمِدْ"],["والمكُّ أولى: نُزِّلَ الفُرقانُ","ويأتينّي النّملِ نونًا ثاني"],["وحَذِرونَ فَرِهينَ: الألفُ","يُثبَتُ في بعضٍ وبعضٍ يُحذَفُ"],["في: وتوكَّلْ عوِّضِ الواوَ بفا","للمدنيْ والشّامِ، والواوَ احذِفا"],["للمكِّ منْ: وقالَ موسى، وألِفْ","لؤلؤا: فاطرٍ بخُلفٍ قدْ أُلِفْ"],["ما عملتْهُ: الها لكوفٍ نُكِّبا","وألفَ: الظُّنونا للكُلِّ اكتُبا"],["منْ صادَ للختمِ فخُلفُها أتى","في: عبدَهُ تالي بكافٍ، وبتا"],["كلمتُ: الطَّوْلِ، وتأمُرونّي","أعبُدُ: للشّامي مزيدُ نونِ"],["أشدَّ منهُمْ: هاءَهُ كافًا قلبْ","والكوفِ: أوْ أنْ يُظهِرَ الهمزَ جلَبْ"],["وسْطَ مُصيبةٍ: بما احذفْ فاءَ","للمدنيِّ والشّامِ، ثمّ هاءَ"],["في: تشتهي زادا، وحُسْنًا رُسِما","في الكوفِ: إحسانًا، فأحسِنْ بهِما"],["في: خاشعًا بـ(اقتربتْ) قدِ اختُلِفْ","وواوُ: ذو العصفِ بشاميٍّ أُلِفْ"],["وإثْرَ شينٍ: المنشَـٰٔتُ الألفُ","وفي العراقِ الياءُ منها خَلَفُ"],["وياءَ ثاني: ذي الجلٰلِ الشّامُ ردّْ","واوًا، وضمَّ النّصبَ في: كُلًّا وعدْ"],["واحذفْ ضميرَ الفصلِ منْ: هوَ الغنيّْ","منْ مصحفِ الشّامِ، كذاكَ المدنيّْ"],["وخُلفُ: قالَ إنّما أدعوا أُلِفْ","ثاني: قواريرا ببصْرٍ مُختلَفْ"],["ولا يخافُ: عوِّضِ الواوَ بفا","للمدنيِّ والشّامِ، والآنَ وَفى"],["فالحمدُ للهِ على حُسْنِ الختامْ","وللنّبيِّ أُنهي صلاتي والسّلامْ"]],"si":[{"s":1,"e":7,"t":"مقدمة ابن عاشر"},{"s":8,"e":16,"t":"من سورة الفاتحة إلى سورة الأعراف"},{"s":17,"e":26,"t":"من سورة الأعراف إلى سورة مريم"},{"s":27,"e":34,"t":"من سورة مريم إلى سورة صاد"},{"s":35,"e":46,"t":"من سورة صاد إلى آخر القرآن"}]}